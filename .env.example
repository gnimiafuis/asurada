# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Process role — what this instance runs:
#   api    → HTTP server only (no background worker)
#   worker → BullMQ worker only (no HTTP server)
#   all    → Both (default — for local dev)
# Deploy API and Worker as separate containers using the SAME image,
# just with different ROLE values.
ROLE=all

# ─────────────────────────────────────────────────────────────
# Postgres (matches docker-compose.yml defaults)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://app:app@localhost:5432/app

# ─────────────────────────────────────────────────────────────
# Redis (matches docker-compose.yml defaults)
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────
# CORS — comma-separated list of allowed origins
# In dev, Vite proxies /api → :3000 so CORS is optional.
# In prod, set this to your frontend origin(s).
# ─────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# AI Agent (LangGraph + OpenAI-compatible LLM)
# Supports: GLM (Zhipu), MiniMax, MiMo (Xiaomi), or any custom
# OpenAI-compatible endpoint (OpenRouter, vLLM, Ollama, etc.)
#
# All providers expose the OpenAI /chat/completions API.
# Pick one of: glm | minimax | mimo | custom
# ─────────────────────────────────────────────────────────────
LLM_PROVIDER=mimo
LLM_API_KEY=your-api-key-here

# Optional overrides (each provider has sensible defaults — international URLs):
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# LLM_MODEL=glm-5.2

# Fallback providers — if the primary fails, try these in order.
# Comma-separated provider keys. Each needs its own API key:
#   LLM_FALLBACK_PROVIDERS=minimax,glm
#   LLM_API_KEY_MINIMAX=xxx
#   LLM_API_KEY_GLM=xxx
# LLM_FALLBACK_PROVIDERS=

# ─────────────────────────────────────────────────────────────
# Web Search Tools — ALL OPTIONAL
# Tools activate automatically when their API key is present.
# DuckDuckGo is always active (free, no key needed).
# At minimum, the agent works with just DuckDuckGo.
# ─────────────────────────────────────────────────────────────
# Tavily — 1,000 free searches/mo — https://app.tavily.com
# TAVILY_API_KEY=tvly-xxx
# Exa — 1,000 free searches/mo — https://exa.ai
# EXA_API_KEY=xxx
# Firecrawl — free tier — https://firecrawl.dev
# FIRECRAWL_API_KEY=fc-xxx

# ── Provider quick reference (international endpoints) ───────
# GLM (Zhipu 智谱):     provider=glm      model=glm-5.2
#                                       baseURL: https://api.z.ai/api/paas/v4
#                                       key from https://z.ai
#                                       (CN alt: https://open.bigmodel.cn/api/paas/v4)
# MiniMax (intl):       provider=minimax  model=MiniMax-M3
#                                       baseURL: https://api.minimax.io/v1
#                                       key from https://www.minimax.io
#                                       (CN alt: https://api.minimax.chat/v1)
# MiMo (Xiaomi 小米):    provider=mimo     model=mimo-v2.5-pro
#                                       baseURL: https://token-plan-sgp.xiaomimimo.com/v1
#                                       (Singapore endpoint — tp- prefixed keys)
# Custom:               provider=custom   set LLM_BASE_URL + LLM_MODEL to any
#                                       OpenAI-compatible endpoint

# ─────────────────────────────────────────────────────────────
# Frontend (Vite — vars MUST be prefixed with VITE_)
# Backend origin the static frontend talks to (cross-origin, CORS required).
# ─────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
