{
  "name": "asurada",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "infra:up": "podman compose up -d",
    "infra:down": "podman compose down",
    "infra:logs": "podman compose logs -f",
    "infra:clean": "podman compose down -v",
    "schedules:cleanup": "pnpm --filter @asurada/api exec tsx scripts/cleanup-ghost-schedules.mts",
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @asurada/api dev",
    "dev:web": "pnpm --filter @asurada/web dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
